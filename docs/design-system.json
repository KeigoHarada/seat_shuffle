{
  "designSystem": {
    "name": "席替えアプリ デザインシステム",
    "version": "1.0.0",
    "description": "Apple Human Interface Guidelines準拠の学校風デザインシステム",
    "lastUpdated": "2025-10-05"
  },
  
  "typography": {
    "primaryFont": {
      "name": "コトノル",
      "fallback": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "description": "モダンでスタイリッシュな日本語フォント。学校風デザインに最適",
      "weights": {
        "thin": "100",
        "extraLight": "200", 
        "light": "300",
        "regular": "400",
        "medium": "500",
        "semiBold": "600",
        "bold": "700",
        "extraBold": "800",
        "heavy": "900",
        "black": "950"
      }
    },
    "scale": {
      "display": {
        "fontSize": "3rem",
        "lineHeight": "1.2",
        "fontWeight": "700",
        "letterSpacing": "-0.02em"
      },
      "title1": {
        "fontSize": "2.5rem", 
        "lineHeight": "1.3",
        "fontWeight": "600",
        "letterSpacing": "-0.01em"
      },
      "title2": {
        "fontSize": "2rem",
        "lineHeight": "1.3", 
        "fontWeight": "600",
        "letterSpacing": "-0.01em"
      },
      "title3": {
        "fontSize": "1.5rem",
        "lineHeight": "1.4",
        "fontWeight": "500"
      },
      "headline": {
        "fontSize": "1.25rem",
        "lineHeight": "1.4",
        "fontWeight": "500"
      },
      "body": {
        "fontSize": "1rem",
        "lineHeight": "1.5",
        "fontWeight": "400"
      },
      "callout": {
        "fontSize": "0.875rem",
        "lineHeight": "1.4",
        "fontWeight": "400"
      },
      "subheadline": {
        "fontSize": "0.875rem",
        "lineHeight": "1.4",
        "fontWeight": "500"
      },
      "footnote": {
        "fontSize": "0.75rem",
        "lineHeight": "1.3",
        "fontWeight": "400"
      },
      "caption1": {
        "fontSize": "0.75rem",
        "lineHeight": "1.3",
        "fontWeight": "500"
      },
      "caption2": {
        "fontSize": "0.625rem",
        "lineHeight": "1.2",
        "fontWeight": "500"
      }
    }
  },

  "colors": {
    "semantic": {
      "primary": {
        "50": "#f0f9ff",
        "100": "#e0f2fe", 
        "200": "#bae6fd",
        "300": "#7dd3fc",
        "400": "#38bdf8",
        "500": "#0ea5e9",
        "600": "#0284c7",
        "700": "#0369a1",
        "800": "#075985",
        "900": "#0c4a6e"
      },
      "secondary": {
        "50": "#f8fafc",
        "100": "#f1f5f9",
        "200": "#e2e8f0", 
        "300": "#cbd5e1",
        "400": "#94a3b8",
        "500": "#64748b",
        "600": "#475569",
        "700": "#334155",
        "800": "#1e293b",
        "900": "#0f172a"
      },
      "success": {
        "50": "#f0fdf4",
        "100": "#dcfce7",
        "200": "#bbf7d0",
        "300": "#86efac",
        "400": "#4ade80",
        "500": "#22c55e",
        "600": "#16a34a",
        "700": "#15803d",
        "800": "#166534",
        "900": "#14532d"
      },
      "warning": {
        "50": "#fffbeb",
        "100": "#fef3c7",
        "200": "#fde68a",
        "300": "#fcd34d",
        "400": "#fbbf24",
        "500": "#f59e0b",
        "600": "#d97706",
        "700": "#b45309",
        "800": "#92400e",
        "900": "#78350f"
      },
      "error": {
        "50": "#fef2f2",
        "100": "#fee2e2",
        "200": "#fecaca",
        "300": "#fca5a5",
        "400": "#f87171",
        "500": "#ef4444",
        "600": "#dc2626",
        "700": "#b91c1c",
        "800": "#991b1b",
        "900": "#7f1d1d"
      }
    },
    "school": {
      "chalkboard": {
        "background": "#2d3748",
        "surface": "#4a5568",
        "border": "#718096"
      },
      "chalk": {
        "primary": "#f7fafc",
        "secondary": "#e2e8f0",
        "muted": "#a0aec0"
      },
      "zones": {
        "front": "#3b82f6",
        "back": "#f59e0b", 
        "window": "#10b981",
        "aisle": "#8b5cf6",
        "center": "#6b7280"
      }
    }
  },

  "spacing": {
    "scale": {
      "0": "0px",
      "1": "0.25rem",
      "2": "0.5rem", 
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem",
      "24": "6rem",
      "32": "8rem"
    },
    "semantic": {
      "xs": "0.5rem",
      "sm": "0.75rem",
      "md": "1rem",
      "lg": "1.5rem", 
      "xl": "2rem",
      "2xl": "3rem",
      "3xl": "4rem"
    }
  },

  "borderRadius": {
    "none": "0px",
    "sm": "0.125rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "2xl": "1rem",
    "3xl": "1.5rem",
    "full": "9999px"
  },

  "shadows": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
    "xl": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)",
    "2xl": "0 25px 50px -12px rgb(0 0 0 / 0.25)"
  },

  "components": {
    "button": {
      "primary": {
        "backgroundColor": "colors.semantic.primary.600",
        "color": "colors.semantic.primary.50",
        "borderRadius": "borderRadius.lg",
        "padding": "spacing.semantic.sm spacing.semantic.lg",
        "fontSize": "typography.scale.body.fontSize",
        "fontWeight": "typography.scale.body.fontWeight",
        "boxShadow": "shadows.sm",
        "hover": {
          "backgroundColor": "colors.semantic.primary.700",
          "boxShadow": "shadows.md"
        },
        "active": {
          "backgroundColor": "colors.semantic.primary.800",
          "transform": "scale(0.98)"
        }
      },
      "secondary": {
        "backgroundColor": "colors.semantic.secondary.100",
        "color": "colors.semantic.secondary.800",
        "borderRadius": "borderRadius.lg",
        "padding": "spacing.semantic.sm spacing.semantic.lg",
        "fontSize": "typography.scale.body.fontSize",
        "fontWeight": "typography.scale.body.fontWeight",
        "border": "1px solid colors.semantic.secondary.300",
        "hover": {
          "backgroundColor": "colors.semantic.secondary.200"
        }
      },
      "ghost": {
        "backgroundColor": "transparent",
        "color": "colors.semantic.primary.600",
        "borderRadius": "borderRadius.lg",
        "padding": "spacing.semantic.sm spacing.semantic.lg",
        "fontSize": "typography.scale.body.fontSize",
        "fontWeight": "typography.scale.body.fontWeight",
        "hover": {
          "backgroundColor": "colors.semantic.primary.50"
        }
      }
    },
    
    "input": {
      "default": {
        "backgroundColor": "colors.semantic.secondary.50",
        "border": "1px solid colors.semantic.secondary.300",
        "borderRadius": "borderRadius.md",
        "padding": "spacing.semantic.sm spacing.semantic.md",
        "fontSize": "typography.scale.body.fontSize",
        "color": "colors.semantic.secondary.900",
        "focus": {
          "borderColor": "colors.semantic.primary.500",
          "boxShadow": "0 0 0 3px colors.semantic.primary.100"
        }
      }
    },

    "card": {
      "default": {
        "backgroundColor": "colors.semantic.secondary.50",
        "borderRadius": "borderRadius.xl",
        "padding": "spacing.semantic.lg",
        "boxShadow": "shadows.md",
        "border": "1px solid colors.semantic.secondary.200"
      },
      "school": {
        "backgroundColor": "colors.school.chalkboard.surface",
        "borderRadius": "borderRadius.xl",
        "padding": "spacing.semantic.lg",
        "boxShadow": "shadows.lg",
        "border": "2px solid colors.school.chalkboard.border"
      }
    },

    "seat": {
      "default": {
        "width": "80px",
        "height": "60px",
        "backgroundColor": "colors.semantic.secondary.100",
        "border": "2px solid colors.semantic.secondary.300",
        "borderRadius": "borderRadius.lg",
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "center",
        "fontSize": "typography.scale.callout.fontSize",
        "fontWeight": "typography.scale.callout.fontWeight",
        "cursor": "pointer",
        "transition": "all 0.2s ease"
      },
      "occupied": {
        "backgroundColor": "colors.semantic.primary.100",
        "borderColor": "colors.semantic.primary.300",
        "color": "colors.semantic.primary.800"
      },
      "empty": {
        "backgroundColor": "colors.semantic.secondary.50",
        "borderColor": "colors.semantic.secondary.200",
        "color": "colors.semantic.secondary.500",
        "opacity": "0.6"
      },
      "hover": {
        "transform": "scale(1.05)",
        "boxShadow": "shadows.md"
      }
    }
  },

  "layouts": {
    "public": {
      "backgroundColor": "colors.school.chalkboard.background",
      "color": "colors.school.chalk.primary",
      "fontFamily": "typography.primaryFont.name",
      "minHeight": "100vh",
      "padding": "spacing.semantic.xl"
    },
    "settings": {
      "backgroundColor": "colors.semantic.secondary.50",
      "color": "colors.semantic.secondary.900",
      "fontFamily": "typography.primaryFont.name",
      "minHeight": "100vh"
    }
  },

  "animations": {
    "duration": {
      "fast": "150ms",
      "normal": "300ms", 
      "slow": "500ms"
    },
    "easing": {
      "ease": "cubic-bezier(0.25, 0.1, 0.25, 1)",
      "easeIn": "cubic-bezier(0.42, 0, 1, 1)",
      "easeOut": "cubic-bezier(0, 0, 0.58, 1)",
      "easeInOut": "cubic-bezier(0.42, 0, 0.58, 1)"
    },
    "shuffle": {
      "duration": "2000ms",
      "easing": "easeInOut",
      "iterations": "infinite"
    }
  },

  "breakpoints": {
    "sm": "640px",
    "md": "768px", 
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },

  "accessibility": {
    "contrast": {
      "minimum": "4.5:1",
      "enhanced": "7:1"
    },
    "focus": {
      "outline": "2px solid colors.semantic.primary.500",
      "outlineOffset": "2px"
    },
    "touchTarget": {
      "minimum": "44px"
    }
  },

  "print": {
    "page": {
      "size": "A4",
      "orientation": "landscape",
      "margin": "20mm"
    },
    "colors": {
      "background": "white",
      "text": "black",
      "borders": "black"
    },
    "typography": {
      "fontSize": "12pt",
      "lineHeight": "1.4"
    }
  }
}
